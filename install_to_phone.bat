@echo off
chcp 65001 > nul
title CrossNavi スマホインストールツール

echo ======================================================================
echo           CrossNavi スマホ実機インストールツール (最新版)
echo ======================================================================
echo.
echo [事前にスマホ側で確認すること]
echo 1. スマホをUSBケーブルでこのPCに接続してください。
echo 2. スマホの「設定」-「開発者向けオプション」で「USBデバッグ」をONにしてください。
echo 3. 接続時にスマホ画面に「USBデバッグを許可しますか?」が出たら「許可」を押してください。
echo.
echo 準備ができたら、キーボードの何かキーを押してください...
pause > nul

set ADB="C:\Users\mayon\AppData\Local\Android\Sdk\platform-tools\adb.exe"

:CHECK_DEVICE
cls
echo ======================================================================
echo  1. 接続中のAndroid端末を確認しています...
echo ======================================================================
echo.
%ADB% devices
echo.

rem 接続端末があるかチェック
%ADB% get-state > nul 2>&1
if %ERRORLEVEL% NEQ 0 (
    echo ----------------------------------------------------------------------
    echo [!] スマホがPCに正しく認識されていません。
    echo.
    echo 【よくある原因と解決策】
    echo 1. USBケーブルが「充電専用」ではありませんか？
    echo    - データ転送ができるケーブルに変えてみてください。
    echo 2. スマホ画面に「USBデバッグを許可しますか？」のポップアップが出ていませんか？
    echo    - スマホ画面を確認し、「常に許可」にチェックを入れて「許可」を押してください。
    echo 3. スマホの通知欄で「USB接続モード」を「ファイル転送 (MTP)」に切り替えてみてください。
    echo ----------------------------------------------------------------------
    echo.
    echo スマホを確認・再接続したら、何かキーを押して再試行してください...
    pause > nul
    goto CHECK_DEVICE
)

echo [OK] スマホが正常に認識されました！
echo.
echo ======================================================================
echo  2. CrossNavi-debug.apk をスマホにインストールしています...
echo ======================================================================
%ADB% install -r -d "%~dp0CrossNavi-debug.apk"
if %ERRORLEVEL% EQU 0 (
    echo.
    echo ======================================================================
    echo  ★ インストールが正常に完了しました！
    echo  スマホ上でアプリを起動します...
    echo ======================================================================
    %ADB% shell am start -n com.example.crossnavi/.MainActivity
) else (
    echo.
    echo [エラー] インストールに失敗しました。
    echo スマホ画面に「提供元不明のアプリをインストールしますか？」などの
    echo 警告が出ている場合は「許可」を押してください。
)

echo.
echo 終了するには何かキーを押してください...
pause > nul
