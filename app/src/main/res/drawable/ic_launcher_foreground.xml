    android:viewportHeight="108">

    <!-- 1. クロスライン1: 左下から右上へ（現物買・上昇を象徴するシアン〜エメラルドグリーン） -->
    <path
        android:pathData="M30,78 L78,30"
        android:strokeWidth="10"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="78"
                android:endX="78"
                android:endY="30"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. クロスライン2: 右下から左上へ（信用売・ヘッジを象徴するゴールド〜アンバー） -->
    <path
        android:pathData="M78,78 L30,30"
        android:strokeWidth="10"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="78"
                android:startY="78"
                android:endX="30"
                android:endY="30"
                android:type="linear">
                <item android:offset="0.0" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#FCD34D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. 中央の優待ギフトエンブレムの背景サークル (深みとコントラスト) -->
    <path
        android:pathData="M54,54m-16,0a16,16 0 1,1 32,0a16,16 0 1,1 -32,0"
        android:fillColor="#0F172A" />

    <!-- サークルのゴールド境界線 -->
