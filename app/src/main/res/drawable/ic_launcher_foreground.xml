        android:strokeWidth="2"
        android:strokeColor="#FFD54F"
        android:fillColor="#00000000" />

    <!-- 4. ギフト（株主優待）ボックス本体 -->
    <!-- ボックス下部 (シアンブルー) -->
    <path
        android:pathData="M44,52 h20 v12 c0,2 -2,4 -4,4 h-12 c-2,0 -4,-2 -4,-4 z"
        android:fillColor="#38BDF8" />

    <!-- ボックス上蓋 (ホワイトゴールド) -->
